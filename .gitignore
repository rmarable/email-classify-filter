################################################################################
# Name:    .gitignore
# Author:  Rodney Marable <rodney.marable@gmail.com>
# Purpose: Files that shouldn't be committed to this repository
################################################################################

# Standard exclusions for Python projects
*~
*#
.DS_Store
.venv/
*.class
*.egg-info/
.idea/
*.pem
*.pyc
*.pyo
*.retry
.serverless
*.swp
*.swo
*.swn
TODO
__pycache__/
creds.yml

# Claude Code local working state (never committed)
CLAUDE.local.md
CLAUDE-STATE.md
state-archive/

# Evaluation data: private cases and on-demand build output
eval/private/
tests/eval/synthetic/.build/
tests/eval/drafts/.build/

# Raw email files anywhere except the synthetic, draft and held-out eval sets
*.eml
!tests/eval/synthetic/**/*.eml
!tests/eval/drafts/**/*.eml
!tests/eval/heldout/**/*.eml
!tests/eval/heldout2/**/*.eml

# Build and tool caches
/dist/
/build/
.pytest_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/

# Agent worktrees (Claude Code)
.claude/worktrees/

# Credentials belong only in the OS secret store; these catch accidents.
# The secret/token patterns cover notes and config files only, so code such as
# secretstore/ and the ADRs and eval cases that mention tokens stay unaffected.
.env
.env.*
*.key
*.p12
*secret*.md
*secret*.txt
*secret*.json
*secret*.yaml
*secret*.yml
*token*.md
*token*.txt
*token*.json
*token*.yaml
*token*.yml
!docs/adr/**
!tests/eval/*/cases/**

# Real-mail corpus files and their labels (SPEC §16.7, OD-466): never in git
*.ecfcorpus
*.ecfcorpus.labels.jsonl
.*.ecfcorpus.partial
